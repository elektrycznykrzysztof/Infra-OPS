# Aplikacja
HOST=0.0.0.0
PORT=3011
# Dodatkowe, zaufane origins dla żądań cross-origin. Ten sam origin co panel jest zawsze dozwolony.
WEB_ORIGINS=http://127.0.0.1:3011,http://localhost:3011
APP_USERNAME=replace-with-a-unique-username
APP_PASSWORD=replace-with-a-long-unique-password
DATABASE_URL=postgresql://dashboard:dashboard@postgres:5432/dashboard
STORAGE_COLLECTION_CRON=0 * * * *
# Alert e-mail po tylu kolejnych nieudanych operacjach PostgreSQL przy snapshotach
SNAPSHOT_DB_FAILURE_THRESHOLD=3
SNAPSHOT_ALERT_EMAIL_TO=
SNAPSHOT_ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Opcjonalnie: katalog logów dzielony między kontenerami postgres i api
POSTGRES_DIAGNOSTICS_DIR=/var/log/postgresql

# Veeam Backup & Replication
VEEAM_BASE_URL=
VEEAM_USERNAME=
VEEAM_PASSWORD=
VEEAM_API_VERSION=1.3-rev1
VEEAM_ALLOW_SELF_SIGNED=false

# Veeam ONE
VEEAM_ONE_BASE_URL=
VEEAM_ONE_USERNAME=
VEEAM_ONE_PASSWORD=
VEEAM_ONE_API_VERSION=2.3
VEEAM_ONE_ALLOW_SELF_SIGNED=false

# VMware vCenter
VCENTER_BASE_URL=
VCENTER_USERNAME=
VCENTER_PASSWORD=
VCENTER_ALLOW_SELF_SIGNED=false
VCENTER_API_BASE_PATH=/api

# Sophos Firewall
SOPHOS_BASE_URL=
SOPHOS_USERNAME=
SOPHOS_PASSWORD=
SOPHOS_API_VERSION=2105.1
SOPHOS_ALLOW_SELF_SIGNED=false
# Opcjonalne osobne konto WebAdmin z dostępem tylko do odczytu list IPsec.
# Pozostaw puste, aby użyć SOPHOS_BASE_URL / SOPHOS_USERNAME / SOPHOS_PASSWORD.
SOPHOS_WEBADMIN_BASE_URL=
SOPHOS_WEBADMIN_USERNAME=
SOPHOS_WEBADMIN_PASSWORD=
SOPHOS_WEBADMIN_ALLOW_SELF_SIGNED=false

# NetApp (dodawaj kolejne pary do 100)
NETAPP_USERNAME=
NETAPP_PASSWORD=
NETAPP_ALLOW_SELF_SIGNED=false
NETAPP_CLUSTER_1_NAME=
NETAPP_CLUSTER_1_URL=

# Discord (pozostaw DISCORD_TOKEN pusty, aby wyłączyć bota)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Discord user IDs allowed to operate the bot; separate multiple IDs with commas.
DISCORD_ALLOWED_USER_IDS=
# Legacy single-ID fallback (used only if DISCORD_ALLOWED_USER_IDS is empty).
DISCORD_ALLOWED_USER_ID=
DISCORD_API_BASE_URL=http://api:3011
